{
  "apiVersion": "tekton.dev/v1",
  "kind": "PipelineRun",
  "metadata": {
    "labels": {
      "app.kubernetes.io/part-of": "tekton-job-standardization",
      "tekton.dev/pipeline": "stack-pr-test"
    },
    "name": "stack-pr-42-fixed",
    "namespace": "tekton-pipelines"
  },
  "spec": {
    "params": [
      {
        "name": "git-url",
        "value": "https://github.com/jmjava/tekton-dag.git"
      },
      {
        "name": "git-revision",
        "value": "main"
      },
      {
        "name": "stack-file",
        "value": "stacks/stack-one.yaml"
      },
      {
        "name": "changed-app",
        "value": "demo-fe"
      },
      {
        "name": "pr-number",
        "value": "42"
      },
      {
        "name": "app-revisions",
        "value": "{\"demo-fe\":\"abc123\"}"
      },
      {
        "name": "image-registry",
        "value": "localhost:5000"
      },
      {
        "name": "cache-repo",
        "value": "localhost:5000/kaniko-cache"
      },
      {
        "name": "intercept-backend",
        "value": "telepresence"
      },
      {
        "name": "dashboard-url",
        "value": ""
      },
      {
        "name": "pr-repo-url",
        "value": ""
      },
      {
        "name": "max-retries",
        "value": "2"
      }
    ],
    "pipelineRef": {
      "name": "stack-pr-test"
    },
    "taskRunTemplate": {
      "serviceAccountName": "tekton-pr-sa"
    },
    "timeouts": {
      "pipeline": "2h"
    },
    "workspaces": [
      {
        "name": "shared-workspace",
        "volumeClaimTemplate": {
          "spec": {
            "accessModes": [
              "ReadWriteOnce"
            ],
            "resources": {
              "requests": {
                "storage": "2Gi"
              }
            }
          }
        }
      },
      {
        "name": "ssh-key",
        "secret": {
          "secretName": "ssh-key-secret"
        }
      },
      {
        "name": "build-cache",
        "persistentVolumeClaim": {
          "claimName": "build-cache-pvc"
        }
      }
    ]
  }
}
